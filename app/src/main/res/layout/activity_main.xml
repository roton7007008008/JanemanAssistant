<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#030811"
    android:padding="16dp">

    <!-- হেডার ও নির্মাতার নাম -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CREATED BY MD ROTON PRAMANIK"
        android:textColor="#4FACFE"
        android:textSize="11sp"
        android:letterSpacing="0.2"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JANEMAN ASSISTANT"
        android:textColor="#00F2FE"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvHudStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● SYSTEM STANDBY"
        android:textColor="#FF3366"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- লাইভ লগ টার্মিনাল -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="vertical"
        android:background="#06101E"
        android:padding="10dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvLiveLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Janeman Assistant: আমি আপনাকে সাহায্য করার জন্য প্রস্তুত আছি..."
            android:textColor="#00F2FE"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- অন/অফ সুইচ ও ভাসমান বাটন -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnToggleAssistant"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="START ASSISTANT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#00F2FE"
            android:textColor="#000000"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnToggleFloatingBall"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Floating Orb"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#0E243D"
            android:textColor="#00F2FE"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAppsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="[ SCANNED INSTALLED APPS ]"
        android:textColor="#4FACFE"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <!-- ফোনের সব অ্যাপ স্ক্যান করে দেখানোর লিস্ট -->
    <ListView
        android:id="@+id/lvInstalledApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#061426"
        android:divider="#0B2342"
        android:dividerHeight="1dp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="Enable Accessibility (TikTok/Scroll)"
        android:textSize="11sp"
        android:backgroundTint="#061220"
        android:textColor="#4FACFE" />

</LinearLayout>
