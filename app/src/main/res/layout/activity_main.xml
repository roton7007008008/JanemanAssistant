<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#030811"
    android:padding="20dp">

    <!-- HUD হেডার -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="STARK INDUSTRIES"
        android:textColor="#4FACFE"
        android:textSize="12sp"
        android:letterSpacing="0.4"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S. HUD"
        android:textColor="#00F2FE"
        android:textSize="26sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvHudStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● PROTOCOL: OFFLINE"
        android:textColor="#FF3366"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="20dp" />

    <!-- কেন্দ্রীয় আর্করিয়্যাক্টর রিং (Glowing Core) -->
    <FrameLayout
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="#061B30"
        android:padding="6dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="MARK VII\nCORE ACTIVE"
            android:textAlignment="center"
            android:textColor="#00F2FE"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- সাইবার টেলিমিতি লগ স্ক্রিন (যেখানে আপনার কথা এবং AI এর উত্তর আসবে) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#06101E"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="// NEURAL COMM CHANNEL"
            android:textColor="#4FACFE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvLiveLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jarvis: Standing by for your instructions, Sir."
            android:textColor="#00F2FE"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ভাসমান জারভিস বাটন চালু করার সুইচ -->
    <Button
        android:id="@+id/btnToggleFloatingBall"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="Show Floating Jarvis Orb"
        android:textSize="13sp"
        android:textStyle="bold"
        android:backgroundTint="#0E243D"
        android:textColor="#00F2FE"
        android:layout_marginBottom="10dp" />

    <!-- মূল অন/অফ সুইচ -->
    <Button
        android:id="@+id/btnToggleAssistant"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="INITIALIZE PROTOCOL"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#00F2FE"
        android:textColor="#000000"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Enable Accessibility (TikTok/Scroll)"
        android:textSize="11sp"
        android:backgroundTint="#061220"
        android:textColor="#4FACFE" />

</LinearLayout>
