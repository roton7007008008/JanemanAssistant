<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#010712"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <!-- HUD টপ টেলিমিতি বার -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CPU: 3.2 GHz // NORMAL\nSYS: JANEMAN OS 64-BIT"
            android:textColor="#26C6DA"
            android:textSize="10sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STARK TECH\nSECURE: 100%"
            android:textColor="#26C6DA"
            android:textSize="10sp"
            android:gravity="end"
            android:fontFamily="monospace" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="J.A.R.V.I.S. INTERFACE"
        android:textColor="#00F2FE"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvHudStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● SYSTEM: OFFLINE"
        android:textColor="#FF1744"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="16dp" />

    <!-- ছবির মতো সেন্ট্রাল আর্করিয়্যাক্টর মিটার ফ্রেম -->
    <FrameLayout
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginBottom="16dp">

        <!-- ঘুরতে থাকা নিওন মিটার কোর -->
        <ProgressBar
            android:id="@+id/ivReactorMeter"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="true"
            android:indeterminateTint="#00F2FE" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARC REACTOR"
                android:textColor="#26C6DA"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCoreStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CORE 100%"
                android:textColor="#00F2FE"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- সাইবার টেলিমিতি লাইভ স্ক্রিন -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#051329"
        android:padding="12dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ NEURAL AUDIO STREAM ]"
            android:textColor="#00F2FE"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvLiveLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Janeman Assistant: সিস্টেমে স্বাগতম স্যার। আমি আপনার আদেশের অপেক্ষায় আছি..."
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- কন্ট্রোল বাটন -->
    <Button
        android:id="@+id/btnToggleAssistant"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="INITIALIZE SYSTEM"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="#00F2FE"
        android:textColor="#000000"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:text="Enable Video Auto-Scroll / Accessibility"
        android:textSize="11sp"
        android:backgroundTint="#0C2548"
        android:textColor="#00F2FE" />

</LinearLayout>
