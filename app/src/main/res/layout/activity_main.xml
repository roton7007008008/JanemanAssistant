<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#020611"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JANEMAN A.I."
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● SYSTEM READY"
        android:textColor="#00E676"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="30dp" />

    <!-- Google Gemini স্টাইল জীবন্ত অর্র্ব (Living Orb) -->
    <FrameLayout
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginBottom="30dp">

        <View
            android:id="@+id/geminiOrbGlow"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="#1E3A8A" />

        <View
            android:id="@+id/geminiOrbCore"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="#00F2FE" />

        <TextView
            android:id="@+id/tvOrbState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="AI ACTIVE"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- ফাস্ট রেসপন্স লাইভ টেক্সট টার্মিনাল -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#08152B"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvLiveLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="শুনছি বস... মুখে যা ইচ্ছা বলুন।"
            android:textColor="#38BDF8"
            android:textSize="16sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnToggleAssistant"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="START ASSISTANT"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#00F2FE"
        android:textColor="#000000"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnEnableAccessibility"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Enable Accessibility (Messenger/Scroll)"
        android:textSize="12sp"
        android:backgroundTint="#0F2444"
        android:textColor="#38BDF8" />

</LinearLayout>
